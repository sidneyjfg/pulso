generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  companies Company[]
  users     UserOrganizationAccess[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id             String     @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  legalName      String
  tradeName      String?
  cnpj           String?
  stateRegistration String?
  municipalRegistration String?
  taxRegime      TaxRegime?
  active         Boolean    @default(true)
  branches       Branch[]
  categories     Category[]
  products       Product[]
  customers      Customer[]
  suppliers      Supplier[]
  sales          Sale[]
  purchases      Purchase[]
  fiscalProfile  CompanyFiscalProfile?
  taxRules       TaxRule[]
  alerts         Alert[]
  alertRules     AlertRule[]
  importJobs     ImportJob[]
  integrationConnections IntegrationConnection[]
  reportJobs     ReportJob[]
  outboxEvents   OutboxEvent[]
  webhookEvents  WebhookEvent[]
  userPreferences UserPreference[]
  stockBalances  StockBalance[]
  stockMovements StockMovement[]
  stockTransfers StockTransfer[]
  inventoryCounts InventoryCount[]
  users          UserCompanyAccess[]
  roles          Role[]
  auditLogs      AuditLog[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([organizationId])
  @@index([organizationId, active])
}

model Branch {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name      String
  active    Boolean  @default(true)
  users     UserBranchAccess[]
  warehouses Warehouse[]
  productPrices ProductBranchPrice[]
  stockBalances StockBalance[]
  stockMovements StockMovement[]
  outgoingTransfers StockTransfer[] @relation("TransferSourceBranch")
  incomingTransfers StockTransfer[] @relation("TransferDestinationBranch")
  inventoryCounts InventoryCount[]
  alerts     Alert[]
  alertRules AlertRule[]
  importJobs ImportJob[]
  integrationConnections IntegrationConnection[]
  reportJobs ReportJob[]
  userPreferences UserPreference[]
  sales     Sale[]
  purchases Purchase[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, active])
}

model Warehouse {
  id        String   @id @default(cuid())
  companyId String
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  name      String
  active    Boolean  @default(true)
  stockBalances StockBalance[]
  stockMovements StockMovement[]
  outgoingTransfers StockTransfer[] @relation("TransferSourceWarehouse")
  incomingTransfers StockTransfer[] @relation("TransferDestinationWarehouse")
  inventoryCounts InventoryCount[]
  sales Sale[]
  purchases Purchase[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, branchId])
}

model Category {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name      String
  active    Boolean  @default(true)
  products  Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId, active])
}

model Product {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sku         String
  name        String
  description String?  @db.Text
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brandId     String?
  unit        String
  costPrice   Decimal? @db.Decimal(15, 2)
  salePrice   Decimal  @db.Decimal(15, 2)
  active      Boolean  @default(true)
  barcodes    ProductBarcode[]
  branchPrices ProductBranchPrice[]
  stockBalances StockBalance[]
  stockMovements StockMovement[]
  transferItems StockTransferItem[]
  inventoryItems InventoryCountItem[]
  saleItems SaleItem[]
  purchaseItems PurchaseItem[]
  fiscalProfile ProductFiscalProfile?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, sku])
  @@index([companyId, name])
  @@index([companyId, createdAt])
  @@index([companyId, active])
}

model ProductBarcode {
  id        String   @id @default(cuid())
  companyId String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  barcode   String
  createdAt DateTime @default(now())

  @@unique([companyId, barcode])
  @@index([productId])
}

model ProductBranchPrice {
  id        String   @id @default(cuid())
  companyId String
  branchId  String
  productId String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  salePrice Decimal  @db.Decimal(15, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, productId])
  @@index([companyId, branchId])
  @@index([companyId, productId])
}

model Customer {
  id          String     @id @default(cuid())
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  type        PersonType
  name        String
  document    String?
  email       String?
  phone       String?
  notes       String?    @db.Text
  active      Boolean    @default(true)
  sales       Sale[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([companyId, document])
  @@index([companyId, name])
  @@index([companyId, active])
  @@index([companyId, createdAt])
}

model Supplier {
  id          String     @id @default(cuid())
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  type        PersonType
  name        String
  document    String?
  email       String?
  phone       String?
  notes       String?    @db.Text
  active      Boolean    @default(true)
  purchases   Purchase[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([companyId, document])
  @@index([companyId, name])
  @@index([companyId, active])
  @@index([companyId, createdAt])
}

model StockBalance {
  id          String   @id @default(cuid())
  companyId   String
  branchId    String
  warehouseId String
  productId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity    Decimal  @default(0) @db.Decimal(15, 3)
  updatedAt   DateTime @updatedAt

  @@unique([companyId, branchId, warehouseId, productId])
  @@index([warehouseId, productId])
  @@index([companyId, branchId, productId])
}

model StockMovement {
  id               String   @id @default(cuid())
  companyId        String
  branchId         String
  warehouseId      String
  productId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch           Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product          Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  type             StockMovementType
  quantity         Decimal  @db.Decimal(15, 3)
  previousQuantity Decimal  @db.Decimal(15, 3)
  currentQuantity  Decimal  @db.Decimal(15, 3)
  referenceType    String?
  referenceId      String?
  reason           String?  @db.Text
  userId           String
  idempotencyKey   String
  createdAt        DateTime @default(now())

  @@unique([companyId, idempotencyKey])
  @@index([companyId, branchId, productId, createdAt])
  @@index([warehouseId, productId])
}

model StockTransfer {
  id                     String   @id @default(cuid())
  companyId              String
  sourceBranchId         String
  sourceWarehouseId      String
  destinationBranchId    String
  destinationWarehouseId String
  company                Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sourceBranch           Branch   @relation("TransferSourceBranch", fields: [sourceBranchId], references: [id], onDelete: Restrict)
  sourceWarehouse        Warehouse @relation("TransferSourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  destinationBranch      Branch   @relation("TransferDestinationBranch", fields: [destinationBranchId], references: [id], onDelete: Restrict)
  destinationWarehouse   Warehouse @relation("TransferDestinationWarehouse", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  status                 StockTransferStatus @default(DRAFT)
  reason                 String?  @db.Text
  createdBy              String
  sentBy                 String?
  receivedBy             String?
  cancelledBy            String?
  idempotencyKey         String
  items                  StockTransferItem[]
  createdAt              DateTime @default(now())
  sentAt                 DateTime?
  receivedAt             DateTime?
  cancelledAt            DateTime?
  updatedAt              DateTime @updatedAt

  @@unique([companyId, idempotencyKey])
  @@index([companyId, sourceBranchId, status, createdAt])
  @@index([companyId, destinationBranchId, status, createdAt])
}

model StockTransferItem {
  id          String   @id @default(cuid())
  transferId  String
  productId   String
  transfer    StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity    Decimal  @db.Decimal(15, 3)
  createdAt   DateTime @default(now())

  @@unique([transferId, productId])
  @@index([productId])
}

model InventoryCount {
  id          String   @id @default(cuid())
  companyId   String
  branchId    String
  warehouseId String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  status      InventoryCountStatus @default(DRAFT)
  notes       String?  @db.Text
  createdBy   String
  confirmedBy String?
  idempotencyKey String
  items       InventoryCountItem[]
  createdAt   DateTime @default(now())
  confirmedAt DateTime?
  cancelledAt DateTime?
  updatedAt   DateTime @updatedAt

  @@unique([companyId, idempotencyKey])
  @@index([companyId, branchId, warehouseId, status, createdAt])
}

model InventoryCountItem {
  id                String   @id @default(cuid())
  inventoryCountId  String
  productId         String
  inventoryCount    InventoryCount @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  countedQuantity   Decimal  @db.Decimal(15, 3)
  expectedQuantity  Decimal? @db.Decimal(15, 3)
  differenceQuantity Decimal? @db.Decimal(15, 3)
  createdAt         DateTime @default(now())

  @@unique([inventoryCountId, productId])
  @@index([productId])
}

model Sale {
  id             String     @id @default(cuid())
  companyId      String
  branchId       String
  warehouseId    String
  customerId     String?
  company        Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch         Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouse      Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  customer       Customer?  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status         SaleStatus @default(COMPLETED)
  subtotal       Decimal    @db.Decimal(15, 2)
  discount       Decimal    @default(0) @db.Decimal(15, 2)
  total          Decimal    @db.Decimal(15, 2)
  source         SaleSource @default(MANUAL)
  createdBy      String
  cancelledBy    String?
  cancelReason   String?    @db.Text
  idempotencyKey String
  items          SaleItem[]
  payments       Payment[]
  createdAt      DateTime   @default(now())
  cancelledAt    DateTime?
  updatedAt      DateTime   @updatedAt

  @@unique([companyId, idempotencyKey])
  @@index([companyId, branchId, status, createdAt])
  @@index([companyId, warehouseId, createdAt])
  @@index([companyId, customerId, createdAt])
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  productId   String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity    Decimal  @db.Decimal(15, 3)
  unitPrice   Decimal  @db.Decimal(15, 2)
  discount    Decimal  @default(0) @db.Decimal(15, 2)
  total       Decimal  @db.Decimal(15, 2)
  createdAt   DateTime @default(now())

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id        String        @id @default(cuid())
  saleId    String
  sale      Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method    PaymentMethod
  amount    Decimal       @db.Decimal(15, 2)
  createdAt DateTime      @default(now())

  @@index([saleId])
}

model Purchase {
  id             String         @id @default(cuid())
  companyId      String
  branchId       String
  warehouseId    String
  supplierId     String?
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch         Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  supplier       Supplier?      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status         PurchaseStatus @default(DRAFT)
  subtotal       Decimal        @db.Decimal(15, 2)
  discount       Decimal        @default(0) @db.Decimal(15, 2)
  total          Decimal        @db.Decimal(15, 2)
  createdBy      String
  receivedBy     String?
  cancelledBy    String?
  cancelReason   String?        @db.Text
  idempotencyKey String
  items          PurchaseItem[]
  createdAt      DateTime       @default(now())
  receivedAt     DateTime?
  cancelledAt    DateTime?
  updatedAt      DateTime       @updatedAt

  @@unique([companyId, idempotencyKey])
  @@index([companyId, branchId, status, createdAt])
  @@index([companyId, supplierId, createdAt])
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  productId   String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity    Decimal  @db.Decimal(15, 3)
  unitCost    Decimal  @db.Decimal(15, 2)
  discount    Decimal  @default(0) @db.Decimal(15, 2)
  total       Decimal  @db.Decimal(15, 2)
  receivedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([purchaseId])
  @@index([productId])
}

model CompanyFiscalProfile {
  id                    String    @id @default(cuid())
  companyId             String    @unique
  company               Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  cnpj                  String
  stateRegistration     String?
  municipalRegistration String?
  taxRegime             TaxRegime
  uf                    String
  municipality          String
  cnae                  String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([companyId, uf])
}

model ProductFiscalProfile {
  id          String              @id @default(cuid())
  companyId   String
  productId   String              @unique
  product     Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  ncm         String?
  cest        String?
  origin      ProductFiscalOrigin @default(NATIONAL)
  fiscalUnit  String
  productType FiscalProductType   @default(MERCHANDISE)
  icmsCst     String?
  icmsCsosn   String?
  pisCst      String?
  cofinsCst   String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([companyId, ncm])
  @@index([companyId, productType])
  @@index([companyId, icmsCst])
  @@index([companyId, pisCst])
  @@index([companyId, cofinsCst])
}

model TaxRule {
  id          String             @id @default(cuid())
  companyId   String
  company     Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name        String
  description String?            @db.Text
  taxType     TaxType
  active      Boolean            @default(true)
  conditions  TaxRuleCondition[]
  versions    TaxRuleVersion[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([companyId, taxType, active])
  @@index([companyId, createdAt])
}

model TaxRuleCondition {
  id        String                   @id @default(cuid())
  taxRuleId String
  taxRule   TaxRule                  @relation(fields: [taxRuleId], references: [id], onDelete: Cascade)
  field     String
  operator  TaxRuleConditionOperator
  value     String
  createdAt DateTime                 @default(now())

  @@index([taxRuleId])
}

model TaxRuleVersion {
  id              String    @id @default(cuid())
  taxRuleId       String
  taxRule         TaxRule   @relation(fields: [taxRuleId], references: [id], onDelete: Restrict)
  version         Int
  validFrom       DateTime
  validUntil      DateTime?
  cfop            String?
  cst             String?
  csosn           String?
  icmsRate        Decimal?  @db.Decimal(7, 4)
  pisRate         Decimal?  @db.Decimal(7, 4)
  cofinsRate      Decimal?  @db.Decimal(7, 4)
  ibsRate         Decimal?  @db.Decimal(7, 4)
  cbsRate         Decimal?  @db.Decimal(7, 4)
  additionalData  Json?
  createdBy       String
  createdAt       DateTime  @default(now())

  @@unique([taxRuleId, version])
  @@index([taxRuleId, validFrom, validUntil])
}

model Alert {
  id          String      @id @default(cuid())
  companyId   String
  branchId    String?
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch      Branch?     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  type        AlertType
  severity    AlertSeverity @default(INFO)
  status      AlertStatus @default(OPEN)
  title       String
  message     String      @db.Text
  entityType  String?
  entityId    String?
  createdBy   String?
  resolvedBy  String?
  createdAt   DateTime    @default(now())
  resolvedAt  DateTime?
  updatedAt   DateTime    @updatedAt

  @@index([companyId, branchId, status, createdAt])
  @@index([companyId, type, status])
  @@index([companyId, entityType, entityId])
}

model AlertRule {
  id          String      @id @default(cuid())
  companyId   String
  branchId    String?
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch      Branch?     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  type        AlertType
  name        String
  active      Boolean     @default(true)
  threshold   Json?
  createdBy   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([companyId, branchId, active])
  @@index([companyId, type, active])
}

model ImportJob {
  id          String          @id @default(cuid())
  companyId   String
  branchId    String?
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch      Branch?         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  source      ImportSource    @default(CSV)
  status      ImportJobStatus @default(DRAFT)
  fileName    String?
  totalRows   Int             @default(0)
  validRows   Int             @default(0)
  invalidRows Int             @default(0)
  summary     Json?
  createdBy   String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([companyId, branchId, status, createdAt])
  @@index([companyId, source, createdAt])
}

model IntegrationConnection {
  id                String            @id @default(cuid())
  companyId         String
  branchId          String?
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch            Branch?           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  channel           SalesChannel
  status            IntegrationStatus @default(DISCONNECTED)
  externalAccountId String?
  connectedAt       DateTime?
  lastSyncAt        DateTime?
  createdBy         String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([companyId, branchId, status])
  @@index([companyId, channel, status])
}

model ReportJob {
  id            String          @id @default(cuid())
  companyId     String
  branchId      String?
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch        Branch?         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  type          ReportType
  status        ReportJobStatus @default(PENDING)
  filters       Json?
  resultSummary Json?
  createdBy     String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([companyId, branchId, status, createdAt])
  @@index([companyId, type, createdAt])
}

model OutboxEvent {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime?
  processedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([companyId, status, createdAt])
  @@index([aggregateType, aggregateId])
}

model WebhookEvent {
  id              String        @id @default(cuid())
  companyId       String?
  company         Company?      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  channel         SalesChannel
  externalEventId String
  eventType       String
  payload         Json
  status          WebhookStatus @default(RECEIVED)
  attempts        Int           @default(0)
  processedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([channel, externalEventId])
  @@index([companyId, status, createdAt])
  @@index([channel, status, createdAt])
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  active        Boolean  @default(true)
  organizationAccesses UserOrganizationAccess[]
  companyAccesses      UserCompanyAccess[]
  branchAccesses       UserBranchAccess[]
  platformAccesses     PlatformUserAccess[]
  sessions      Session[]
  refreshTokens RefreshToken[]
  preferences   UserPreference[]
  auditLogs     AuditLog[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PlatformUserAccess {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  active    Boolean  @default(true)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, roleId])
  @@index([userId, active])
}

model UserOrganizationAccess {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  roleId         String
  active         Boolean      @default(true)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId, active])
}

model UserCompanyAccess {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  roleId    String
  active    Boolean  @default(true)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, companyId])
  @@index([companyId, active])
}

model UserBranchAccess {
  id        String   @id @default(cuid())
  userId    String
  branchId  String
  roleId    String
  active    Boolean  @default(true)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, branchId])
  @@index([branchId, active])
}

model Role {
  id        String   @id @default(cuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name      String
  scope     PermissionScope
  system    Boolean  @default(false)
  permissions RolePermission[]
  organizationAccesses UserOrganizationAccess[]
  companyAccesses UserCompanyAccess[]
  branchAccesses UserBranchAccess[]
  platformAccesses PlatformUserAccess[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name, scope])
  @@index([companyId, scope])
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String
  roles       RolePermission[]
  createdAt   DateTime @default(now())
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
}

model UserPreference {
  id                     String   @id @default(cuid())
  userId                 String
  companyId              String
  branchId               String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  company                Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch                 Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  darkMode               Boolean  @default(false)
  compactMenu            Boolean  @default(true)
  showSavings            Boolean  @default(true)
  confirmCriticalActions Boolean  @default(true)
  sessionWarnings        Boolean  @default(true)
  hideSensitiveData      Boolean  @default(false)
  blockNegativeStock     Boolean  @default(true)
  lowStockAlerts         Boolean  @default(true)
  currentBranchOnly      Boolean  @default(true)
  showFiscalPending      Boolean  @default(true)
  prepareChannelSync     Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([userId, companyId, branchId])
  @@index([companyId, branchId])
  @@index([userId])
}

model Session {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  status    SessionStatus @default(ACTIVE)
  activeOrganizationId String?
  activeCompanyId      String?
  activeBranchId       String?
  ip        String?
  userAgent String?       @db.Text
  createdAt DateTime      @default(now())
  revokedAt DateTime?

  @@index([userId, status])
  @@index([activeOrganizationId, activeCompanyId, activeBranchId])
}

model RefreshToken {
  id        String             @id @default(cuid())
  userId    String
  sessionId String
  user      User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  tokenHash String             @unique
  status    RefreshTokenStatus @default(ACTIVE)
  expiresAt DateTime
  rotatedToTokenId String?
  createdAt DateTime           @default(now())
  revokedAt DateTime?
  reusedAt  DateTime?

  @@index([userId, status])
  @@index([sessionId, status])
}

model AuditLog {
  id            String   @id @default(cuid())
  companyId     String?
  branchId      String?
  userId        String?
  company       Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user          User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
  action        String
  entityType    String
  entityId      String?
  before        Json?
  after         Json?
  ip            String?
  userAgent     String?  @db.Text
  correlationId String
  createdAt     DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([branchId, createdAt])
  @@index([userId, createdAt])
  @@index([correlationId])
}

