NODE_ENV=production
APP_NAME=Pulso ERP
APP_ENV=production

WEB_URL=https://app.seudominio.com
NEXT_PUBLIC_API_URL=https://app.seudominio.com

API_HOST=0.0.0.0
API_PORT=3333
API_URL=https://app.seudominio.com
TRUST_PROXY=true
INTERNAL_JOB_SECRET=troque_por_um_valor_aleatorio_com_32_caracteres_ou_mais

CORS_ORIGINS=https://app.seudominio.com

# Ajuste connection_limit conforme replicas da API e max_connections do MySQL.
# Exemplo: max_connections 150, 3 replicas api + 1 worker => connection_limit 20 deixa margem operacional.
DATABASE_URL=mysql://usuario:senha@mysql-host:3306/erp?connection_limit=20&pool_timeout=10
REDIS_URL=redis://redis:6379

JWT_USER_SECRET=troque_por_um_valor_aleatorio_com_32_caracteres_ou_mais
JWT_USER_ISSUER=pulso-production
JWT_USER_AUDIENCE=erp-user-api
JWT_USER_EXPIRES_IN=15m

JWT_ADMIN_SECRET=troque_por_outro_valor_aleatorio_com_32_caracteres_ou_mais
JWT_ADMIN_ISSUER=pulso-production
JWT_ADMIN_AUDIENCE=erp-admin-api
JWT_ADMIN_EXPIRES_IN=10m

REFRESH_TOKEN_EXPIRES_IN_DAYS=30

COOKIE_DOMAIN=app.seudominio.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

DATA_ENCRYPTION_KEY=troque_por_um_valor_aleatorio_com_32_caracteres_ou_mais

RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_STORE=redis
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW=15m

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/app/storage

LOG_LEVEL=info

IFOOD_ENABLED=false
FOOD99_ENABLED=false
IFOOD_API_URL=https://merchant-api.ifood.com.br
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_ORDER_POLLING_ENABLED=true
IFOOD_ORDER_POLLING_INTERVAL_MS=30000
IFOOD_ORDER_POLLING_CONNECTION_LIMIT=25

DEV_SEED=false
DEV_ADMIN_EMAIL=admin@seudominio.com
DEV_ADMIN_PASSWORD=troque_antes_de_usar
DEV_ORGANIZATION_NAME=Pulso
DEV_COMPANY_NAME=Pulso
DEV_BRANCH_NAME=Principal
